# AI CV SaaS
#
# Copy this file to .env for local development.
# Never commit the real .env file.

# Application
APP_ENV=development

# AI provider
# Supported currently:
#   openai
#   gemini
AI_PROVIDER=gemini
AI_MODEL=

# OpenAI
OPENAI_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# AWS runtime
AWS_REGION=me-central-1
AWS_PROFILE=
DOCUMENTS_BUCKET_NAME=
ORDERS_TABLE_NAME=

PROCESSING_QUEUE_URL=
